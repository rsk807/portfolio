    {
      "@type": "FAQPage",
      "@id": "https://rsk807.github.io/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is Sushant Kumar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sushant Kumar is a Cyber Security Engineer, Digital Forensics Researcher, AI Systems Developer, and Founder of TechDenLab in Pune, India. Studying at MIT-WPU (CGPA 9.16), he specializes in IoT security, edge intelligence, cybercrime investigation automation, and cloud infrastructure architectures."
          }
        },
        {
          "@type": "Question",
          "name": "What is TechDenLab?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "TechDenLab is an engineering research and technology laboratory founded by Sushant Kumar. It specializes in developing secure embedded IoT hardware, client-edge AI privacy models, cloud infrastructure architectures, and automated digital forensics tools."
          }
        },
        {
          "@type": "Question",
          "name": "What is the VACARS smart helmet system?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "VACARS (Voice Assisted Context Aware Response System) is an IoT and AI assisted smart helmet published in a Springer Nature journal. It integrates Raspberry Pi hardware, MobileNet-SSD edge obstacle detection, offline speech recognition, 350ms motorized faceplate actuation, and real-time accident crash telemetry."
          }
        },
        {
          "@type": "Question",
          "name": "What is the Omniscient digital forensics patent?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Omniscient is a published Indian Patent Application (ID: 202521077464, Indian Patent Office InPASS) titled 'A System and Method for Dynamic Cybercrime Investigation Using Automated Data Extraction and Analysis'. It automates multi-device evidence extraction, artifact timeline sequencing, and anti-forensic detection in 8.2 seconds."
          }
        },
        {
          "@type": "Question",
          "name": "What research has Sushant Kumar published?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sushant Kumar published research in a Springer Nature journal on the VACARS smart helmet, and won the Best IEEE Research Paper Award at ICCUBEA 2026 (PCCOE Pune, Blockchain & Cyber Security Track) for his early-exit hybrid intrusion detection architecture."
          }
        },
        {
          "@type": "Question",
          "name": "What is RakshaNetra and how does it protect LLM privacy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "RakshaNetra is a proactive client-edge Data Leakage Prevention (DLP) system for LLMs. Running via browser service workers, it intercepts, evaluates, and redacts sensitive enterprise tokens, PII, and credentials in under 14ms prior to API transmission, eliminating third-party data leaks."
          }
        },
        {
          "@type": "Question",
          "name": "What is BidForge and how does it operate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "BidForge is an autonomous multi-agent proposal generation pipeline built on Bun, TypeScript, LangChain, Google Gemini 2.5 Flash, and MongoDB vector search. It ingests complex RFP documents, matches compliance specifications, and synthesizes publication-grade PDF proposals on AWS S3 in under 45 seconds."
          }
        },
        {
          "@type": "Question",
          "name": "What major awards and honors has Sushant Kumar received?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sushant Kumar's honors include the Best IEEE Research Paper Award (ICCUBEA 2026), MIT-WPU Best Student Achiever Award, serving as Youngest Industry Judge at IIT Bombay's Ignition T3 Eureka Pitch Perfect, DevConf 2025 Speaker, 2nd Place at Ignisia AI 2026, and Ciphathon 2026 Finalist."
          }
        }
      ]
    }
